<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>CV - {{ profile.identity.full_name }}</title>
  <style>
    @page {
      size: A4;
      margin: 12mm 15mm 10mm 15mm;
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      color: #111111;
      font-family: Arial, Helvetica, sans-serif;
      font-size: var(--body-size);
      line-height: var(--line-height);
      min-height: calc(297mm - 22mm);
      display: flex;
      flex-direction: column;
    }

    header {
      flex-shrink: 0;
    }

    .sections {
      flex: 1 1 auto;
      display: flex;
      flex-direction: column;
      gap: var(--section-gap);
    }

    body.cv-very-airy {
      --body-size: 10.6pt;
      --line-height: 1.42;
      --header-gap: 22px;
      --section-gap: 18px;
      --section-title-gap: 9px;
      --entry-gap: 13px;
      --project-gap: 8px;
    }

    body.cv-airy {
      --body-size: 10.35pt;
      --line-height: 1.34;
      --header-gap: 18px;
      --section-gap: 14px;
      --section-title-gap: 8px;
      --entry-gap: 10px;
      --project-gap: 6px;
    }

    body.cv-balanced {
      --body-size: 9.7pt;
      --line-height: 1.22;
      --header-gap: 14px;
      --section-gap: 10px;
      --section-title-gap: 6px;
      --entry-gap: 7px;
      --project-gap: 4px;
    }

    body.cv-compact,
    body.cv-ultra {
      --body-size: 9pt;
      --line-height: 1.12;
      --header-gap: 10px;
      --section-gap: 7px;
      --section-title-gap: 4px;
      --entry-gap: 5px;
      --project-gap: 2px;
    }

    body.cv-ultra {
      --body-size: 8.65pt;
      --line-height: 1.06;
      --header-gap: 8px;
      --section-gap: 5px;
      --section-title-gap: 3px;
      --entry-gap: 4px;
      --project-gap: 1px;
    }

    h1 {
      margin: 0 0 3px 0;
      font-size: 15.8pt;
      line-height: 1;
      font-weight: 500;
      letter-spacing: 0;
    }

    .summary {
      margin: 0 0 8px 0;
      max-width: 183mm;
      font-size: 9.7pt;
      font-style: italic;
    }

    .contact {
      margin: 0 0 var(--header-gap) 0;
      font-size: 9.2pt;
    }

    .contact a {
      color: #2368d1;
      text-decoration: none;
    }

    .contact-separator {
      color: #333333;
    }

    .section {
      flex-shrink: 0;
      margin-top: 0;
    }

    .section-title {
      margin: 0 0 var(--section-title-gap) 0;
      padding-bottom: 2px;
      border-bottom: 1px solid #111111;
      color: #2368d1;
      font-size: 10.5pt;
      line-height: 1.1;
      font-weight: 700;
      letter-spacing: 1px;
    }

    .entry {
      display: grid;
      grid-template-columns: 38mm 1fr;
      column-gap: 7mm;
      margin-bottom: var(--entry-gap);
      break-inside: avoid;
    }

    .entry-left {
      font-size: 9.2pt;
      white-space: pre-line;
    }

    .entry-title {
      margin-bottom: 1px;
      font-size: 9.5pt;
    }

    .entry-title strong {
      font-weight: 700;
    }

    .bullets {
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .bullets li {
      position: relative;
      margin: 0 0 0 12px;
    }

    .bullets li::before {
      content: "-";
      position: absolute;
      left: -9px;
    }

    .skills p,
    .languages p,
    .certificates p,
    .projects p {
      margin: 0 0 var(--project-gap) 0;
    }

    .skills strong,
    .projects strong,
    .certificates strong {
      font-weight: 700;
    }

    .project-row {
      position: relative;
      padding-left: 11px;
      break-inside: avoid;
    }

    .project-row::before {
      content: "-";
      position: absolute;
      left: 0;
    }

    .inline-link,
    .project-link {
      display: inline-block;
      width: 0.9em;
      height: 0.9em;
      margin-left: 4px;
      color: #2368d1;
      text-decoration: none;
      vertical-align: 0.05em;
    }

    .inline-link::before,
    .project-link::before {
      content: "\2197";
      font-size: 0.82em;
      font-weight: 700;
    }

    .muted {
      color: #333333;
    }
  </style>
</head>
<body class="{{ layout_class }}">
  <header>
    <h1>{{ profile.identity.full_name }}</h1>
    <p class="summary">{{ adapted.professional_summary }}</p>
    <p class="contact">
      {% for item in contact_items -%}
      {% if item.href %}<a href="{{ item.href }}">{{ item.label }}</a>{% else %}{{ item.label }}{% endif %}{% if not loop.last %}<span class="contact-separator"> | </span>{% endif %}
      {%- endfor %}
    </p>
  </header>

  <div class="sections">
  {% if experiences %}
  <section class="section">
    <h2 class="section-title">Professional Experience</h2>
    {% for item in experiences %}
    <div class="entry">
      <div class="entry-left">{{ item.source.start_date }} &ndash; {{ item.source.end_date }}
{{ item.source.location }}</div>
      <div class="entry-right">
        <div class="entry-title"><strong>{{ item.source.title }}</strong>, {{ item.source.company }}{% if item.source.url %}<a class="inline-link" href="{{ item.source.url }}" aria-label="{{ item.source.company }} website"></a>{% endif %}</div>
        <ul class="bullets">
          {% for bullet in item.bullets %}
          <li>{{ bullet.html }}</li>
          {% endfor %}
        </ul>
      </div>
    </div>
    {% endfor %}
  </section>
  {% endif %}

  {% if education %}
  <section class="section">
    <h2 class="section-title">Education</h2>
    {% for degree in education %}
    <div class="entry">
      <div class="entry-left">{{ degree.start_year }} &ndash; {{ degree.end_year }}</div>
      <div class="entry-right">
        <div class="entry-title">
          <strong>{{ degree.title }}{% if degree.field %} &ndash; {{ degree.field }}{% endif %}</strong>{% if degree.url %}<a class="inline-link" href="{{ degree.url }}" aria-label="Degree page"></a>{% endif %},
        </div>
        <div>{{ degree.institution }}</div>
      </div>
    </div>
    {% endfor %}
  </section>
  {% endif %}

  {% if skill_categories %}
  <section class="section skills">
    <h2 class="section-title">Skills</h2>
    {% for category in skill_categories %}
    <p><strong>{{ category.name }}:</strong> {{ category.skills | join(", ") }}</p>
    {% endfor %}
  </section>
  {% endif %}

  {% if projects %}
  <section class="section projects">
    <h2 class="section-title">Projects</h2>
    {% for project in projects %}
    <p class="project-row">
      <strong>{{ project.name }}</strong>{% if project.url %}<a class="project-link" href="{{ project.url }}" aria-label="Project repository"></a>{% endif %}
      &nbsp;{{ project.description }}
    </p>
    {% endfor %}
  </section>
  {% endif %}

  {% if languages %}
  <section class="section languages">
    <h2 class="section-title">Languages</h2>
    <p>
      {% for language in languages -%}
      {{ language.name }} &mdash; {{ language.level }}{% if not loop.last %} | {% endif %}
      {%- endfor %}
    </p>
  </section>
  {% endif %}

  {% if certificates %}
  <section class="section certificates">
    <h2 class="section-title">Certificates</h2>
    {% for certificate in certificates %}
    <p><strong>{{ certificate.name }}</strong>{% if certificate.url %}<a class="inline-link" href="{{ certificate.url }}" aria-label="Certificate verification"></a>{% endif %} &mdash; {{ certificate.issuer }}{% if certificate.description %} &mdash; <span class="muted">{{ certificate.description }}</span>{% endif %}</p>
    {% endfor %}
  </section>
  {% endif %}
  </div>
</body>
</html>
