# ============================================================
# SmartApply AI — Configuration
# Copy this file to .env and fill the values you need.
# ============================================================

# ---- LLM Provider ----
# Active provider: openai | anthropic | mock
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL_CHEAP=gpt-4o-mini
OPENAI_MODEL_SMART=gpt-4o
OPENAI_MODEL_EMBED=text-embedding-3-small

# Optional Anthropic fallback (if LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_CHEAP=claude-haiku-4-5
ANTHROPIC_MODEL_SMART=claude-sonnet-4-6

# ---- Embeddings Provider ----
# openai | local
EMBEDDINGS_PROVIDER=openai
LOCAL_EMBEDDINGS_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# ---- Database ----
DATABASE_URL=sqlite:///./data/smartapply.db

# ---- Paths ----
PROFILE_DIR=./smartapply/profile/data
OUTPUT_DIR=./data/output
CACHE_DIR=./data/cache
SAMPLES_DIR=./data/samples

# ---- Job Sources ----
# Active sources, comma-separated. Available: serpapi, francetravail, manual
JOB_SOURCES=serpapi,francetravail,manual

# SerpApi (Google Jobs)
# https://serpapi.com/google-jobs-api
SERPAPI_API_KEY=
SERPAPI_GOOGLE_DOMAIN=google.com
SERPAPI_HL=en,fr
SERPAPI_GL=fr
SERPAPI_DEFAULT_LOCATION=Paris, France
# Number of paginated pages to fetch per query (10 results per page)
SERPAPI_MAX_PAGES=3
# Low-result fallback target. Keep 10 by default; use 20 with max pages >= 2.
SERPAPI_LOW_RESULT_FALLBACK_TARGET=10
# Freshness filter for Google Jobs: any, today, 3days, week, month.
# Default recommendation: week = offers from the last 7 days.
SERPAPI_DATE_POSTED=week
# Optional advanced raw filter copied from SerpApi filters[].parameters.uds.
SERPAPI_UDS=

# France Travail API (free, official)
# https://francetravail.io
FRANCETRAVAIL_CLIENT_ID=
FRANCETRAVAIL_CLIENT_SECRET=
FRANCETRAVAIL_SCOPE=api_offresdemploiv2 o2dsoffre

# ---- Contact enrichment (Anymail Finder, optional) ----
ANYMAILFINDER_API_KEY=
ANYMAILFINDER_TIMEOUT=180
ANYMAILFINDER_MAX_CONTACTS=5
ANYMAILFINDER_DECISION_MAKER_CATEGORIES=hr,engineering,it
ANYMAILFINDER_COMPANY_EMAIL_TYPE=generic
ANYMAILFINDER_VERIFY_MANUAL_CONTACTS=false
ANYMAILFINDER_VERIFY_CACHED_EXTERNAL_CONTACTS=false
# Cache contact lookups to avoid spending credits twice for the same company/domain.
CONTACT_CACHE_ENABLED=true
CONTACT_CACHE_TTL_DAYS=45
CONTACT_CACHE_NEGATIVE_TTL_DAYS=14

# ---- Gmail OAuth ----
# Place credentials.json (Google Cloud OAuth desktop client) in ./secrets/
# The token will be created on first auth.
GMAIL_CREDENTIALS_PATH=./secrets/credentials.json
GMAIL_TOKEN_PATH=./secrets/token.json
GMAIL_USER=me

# ---- Pipeline tuning ----
TOP_K_RANKED=25
TOP_K_CV_BLOCKS=8
DEDUP_TITLE_THRESHOLD=85
DEDUP_DESC_THRESHOLD=70
AUTOPILOT_TARGET_DRAFTS=25
AUTOPILOT_MIN_SCORE=0.62
AUTOPILOT_CONTACT_MIN_CONFIDENCE=0.60
AUTOPILOT_REQUIRE_QUALITY_GATE=true
AUTOPILOT_ANALYZE_MULTIPLIER=2.0
AUTOPILOT_CANDIDATE_MULTIPLIER=3.0

# ---- Logging ----
LOG_LEVEL=INFO
